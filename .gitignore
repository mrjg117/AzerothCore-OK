# 环境变量
.env

# 数据目录
data/
logs/

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
env/
ac-deploy-*.tar.gz
node_modules

# 地图数据（构建时从 wowgaming/client-data 下载烤入 ac-maps 镜像，不落库）
config/maps/data/

# 客户端补丁整包（构建时现打，不进仓库）
patches-client.zip
client-patches/patches-client.zip

# 构建产物（不进仓库）
client-patches/*/addon/                      # 构建期按 addons.txt 从上游克隆的 AddOn
client-patches/*/Interface/addons/           # 构建期按 .toc 规则从 modules 提取的客户端插件
client-patches/*/data/zhcn/                 # 构建期按 .toc 规则从 modules 提取的 zhCN 数据/MPQ
deploy/patches/patches-client.zip
deploy/patches/patches-client.zip.*          # split 分卷产物
deploy/patches/patches-manifest.txt          # 分卷清单（构建生成）
deploy/docker-compose.yml                    # 官方基础编排，构建时从 GitHub 拉下打包，不进仓库
__pycache__/
*.pyc

# 本地排查产物（CI 日志 / 审计草稿，不进仓库）
.run*.log
run*.log
run*.err
cache_dance_run.log
*_full_audit.md
*_review.md

# WorkBuddy 会话缓存（记忆/automations/ci 等）属 AI 工具产物，非项目文件，一律不入库
.workbuddy/
