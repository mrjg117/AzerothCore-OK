# AzerothCore-OK 服务端部署变量（acok.sh 会复制为 .env）
# 改完后再跑 docker compose up -d

# 数据库 root 密码（Docker 内网，不暴露公网；默认值可直接用，部署时 acok.sh 会交互提示可改）
DOCKER_DB_ROOT_PASSWORD=AcokDbRoot2026!

# 对外地址：玩家连接 / 客户端 realmlist.wtf 填这个（你的公网域名或 IP）
REALM_ADDRESS=play.example.com

# 镜像命名空间（ghcr.io，默认 mrjg117；换别的仓库改这里）
IMAGE_NS=ghcr.io/mrjg117

# 数据库镜像（默认本仓 ghcr 同步的 mysql:8.4；部署机直连 ghcr 免走 Docker Hub。自定义改这里）
DB_IMAGE=ghcr.io/mrjg117/ac-wotlk-mysql:8.4

# 注册 SOAP 账号（仅作 acok.sh 本地 .env 模板占位；游戏服首次运行会交互覆盖）。
# 真实值：SOAP_LOGIN 默认 ACOK；SOAP_PASSWORD 由你在 CF 后台 Variables & Secrets 手动设置（游戏服 acok.sh 运行时输入同一值），
# 游戏服 acok.sh 运行时手动输入同一密码（此处占位不会被部署到 Worker）。
SOAP_LOGIN=ACOK
SOAP_PASSWORD=AUTOGENERATE

# 部署镜像来源：ghcr（默认直连）| external（外置储存整镜像包，免 ghcr 拉取）
DEPLOY_SRC=ghcr
# 外置储存基础目录 URL（仅 DEPLOY_SRC=external 时生效），如 https://disk.example.org/acok/
EXT_STORAGE_BASE=
